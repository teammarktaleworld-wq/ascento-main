model Teacher {
  id              String           @id @default(uuid())
  userId          String           @unique
  name            String
  phone           String?
  experience      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  designation     String?
  photoUrl        String?
  wifeOrHusbandOf String?
  dateOfBirth     DateTime?
  status          String           @default("Active")
  subjects        TeacherSubject[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}

model Subject {
  id        String           @id @default(uuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  teachers  TeacherSubject[]

  @@map("subjects")
}
model Webinar {
  id                    String          @id @default(cuid())
  title                 String
  description           String?
  platform              WebinarPlatform @default(zoom)
  meetingLink           String
  meetingId             String?
  passcode              String?
  hostName              String?
  hostEmail             String?
  scheduledAt           DateTime
  durationMins          Int             @default(60)
  status                WebinarStatus   @default(active)
  programId             String?
  levelId               String?
  emailSent             Boolean         @default(false)
  emailSentAt           DateTime?
  bannerUrl             String?
  attachmentUrl         String?
  attachmentName        String?
  attachmentType        String?
  attachmentSize        Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  emailSentCount        Int             @default(0)
  notificationSent      Boolean         @default(false)
  notificationSentAt    DateTime?
  notificationSentCount Int             @default(0)
  notifications         Notification[]
  emailLogs             WebinarEmailLog[]
  notificationLogs      WebinarNotificationLog[]
  level                 ProgramLevel?   @relation(fields: [levelId], references: [id])
  program               Program?        @relation(fields: [programId], references: [id])

  @@index([scheduledAt])
  @@index([programId])
  @@index([status])
  @@map("webinars")
}

model WebinarEmailLog {
  id         String    @id @default(cuid())
  webinarId  String
  studentId  String?
  userId     String?
  email      String
  name       String
  status     String    // "sent" | "failed"
  errorMsg   String?
  resendId   String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  webinar    Webinar   @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId])
  @@index([status])
  @@map("webinar_email_logs")
}

model WebinarNotificationLog {
  id         String    @id @default(cuid())
  webinarId  String
  userId     String
  name       String
  status     String    // "sent" | "failed"
  errorMsg   String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  webinar    Webinar   @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId])
  @@index([status])
  @@map("webinar_notification_logs")
}




model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(general)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  webinarId String?
  createdAt DateTime         @default(now())
  examId    String?
  exam      Exam?            @relation(fields: [examId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar   Webinar?         @relation(fields: [webinarId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([examId])
  @@map("notifications")
}

model TeacherSubject {
  teacherId  String
  subjectId  String
  assignedAt DateTime @default(now())
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

model HomeworkFile {
  id          String   @id @default(uuid())
  serialId    Int      @unique
  title       String
  label       String?
  fileType    String
  fileUrl     String
  storagePath String
  createdAt   DateTime @default(now())

  @@map("homework_files")
}

model Enquiry {
  id          String   @id @default(uuid())
  studentName String
  email       String
  phone       String?
  course      String?
  source      String?
  message     String?
  status      String   @default("New")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("EnquiryCreatedBy", fields: [createdById], references: [id])

  @@map("enquiries")
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  markedBy  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId])
  @@map("attendance")
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  message     String
  priority    AnnouncementPriority @default(normal)
  audience    AnnouncementAudience @default(all)
  programId   String?
  levelId     String?
  expiresAt   DateTime?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  emailSent   Boolean              @default(false)
  fileName    String?
  fileType    String?
  fileUrl     String?
  storagePath String?
  level       ProgramLevel?        @relation(fields: [levelId], references: [id])
  program     Program?             @relation(fields: [programId], references: [id])
   emailSentCount  Int                    @default(0)
emailLogs       AnnouncementEmailLog[]


  @@index([audience])
  @@index([programId])
  @@index([isActive])
  @@map("announcements")
}


model AnnouncementEmailLog {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  email          String
  status         String       // "sent" | "failed"
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([status])
  @@map("announcement_email_logs")
}





model ScheduleSlot {
  id           String        @id @default(cuid())
  programId    String
  levelId      String?
  dayOfWeek    String
  periodNumber Int
  startTime    String
  endTime      String
  subjectName  String
  teacherName  String
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  level        ProgramLevel? @relation(fields: [levelId], references: [id])
  program      Program       @relation(fields: [programId], references: [id])

  @@unique([programId, levelId, dayOfWeek, periodNumber])
  @@index([programId])
  @@index([levelId])
  @@map("schedule_slots")
}

model TimetableUpload {
  id           String        @id @default(cuid())
  programId    String?
  levelId      String?
  originalName String
  storagePath  String
  url          String
  mimeType     String
  size         Int
  createdAt    DateTime      @default(now())
  level        ProgramLevel? @relation(fields: [levelId], references: [id])
  program      Program?      @relation(fields: [programId], references: [id])

  @@index([programId])
  @@map("timetable_uploads")
}

enum UserRole {
  admin
  student
  user
  teacher
}

enum UserStatus {
  Active
  Inactive
  Suspended
  Deleted
}

enum NoteType {
  DEMO
  REAL
}

enum AttendanceStatus {
  present
  absent
  late
  holiday
}

enum FeeStatus {
  Pending
  Paid
  Partial
  Overdue
  Waived
}

enum AnnouncementPriority {
  info
  normal
  urgent
}

enum WebinarStatus {
  active
  inactive
}

enum WebinarPlatform {
  zoom
  google_meet
  microsoft_teams
  other
}

enum NotificationType {
  webinar
  announcement
  exam
  attendance
  general
}

enum AnnouncementAudience {
  all
  program
  level
  teachers
  students
}

enum CouponScope {
  global
  note
  test_paper
}
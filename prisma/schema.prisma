model PortalCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  description String       @default("")
  slug        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  portalPapers PortalPaper[]

  @@map("portal_categories")
}

model PortalPaper {
  id                    String    @id @default(cuid())
  title                 String
  description           String    @default("")
  categoryId            String
  duration              Int       @default(60)    // minutes
  totalMarks            Int       @default(100)
  passingMarks          Int       @default(40)
  isActive              Boolean   @default(true)
  isPublished           Boolean   @default(false)
  shuffleQuestions      Boolean   @default(false)
  allowReview           Boolean   @default(true)
  showResultImmediately Boolean   @default(true)
  maxAttempts           Int       @default(1)
  startDate             DateTime?
  endDate               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  category              PortalCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  portalQuestions       PortalQuestion[]
  portalRegistrations   PortalRegistration[]

  @@index([categoryId])
  @@index([isPublished])
  @@index([startDate])
  @@map("portal_papers")
}

model PortalQuestion {
  id                 String   @id @default(cuid())
  paperId            String
  questionText       String   @db.Text
  // Stored as JSON string: [{"text":"Option A"},{"text":"Option B"},...]
  options            String   @db.Text
  correctOptionIndex Int
  marks              Int      @default(1)
  explanation        String   @default("") @db.Text
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  paper              PortalPaper           @relation(fields: [paperId], references: [id], onDelete: Cascade)
  portalAnswers      PortalAnswer[]

  @@index([paperId])
  @@index([order])
  @@map("portal_questions")
}

model PortalRegistration {
  id            String                   @id @default(cuid())
  userId        String
  paperId       String
  status        PortalRegistrationStatus @default(registered)
  score         Int?
  totalMarks    Int                      @default(0)
  percentage    Float?
  passed        Boolean?
  startedAt     DateTime?
  submittedAt   DateTime?
  timeTaken     Int?                     // seconds
  attemptNumber Int                      @default(1)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user          User           @relation("PortalRegistrations", fields: [userId], references: [id], onDelete: Cascade)
  paper         PortalPaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  portalAnswers PortalAnswer[]

  @@unique([userId, paperId, attemptNumber])
  @@index([userId])
  @@index([paperId])
  @@index([status])
  @@map("portal_registrations")
}

model PortalAnswer {
  id             String   @id @default(cuid())
  registrationId String
  questionId     String
  selectedIndex  Int?     // null = skipped
  isCorrect      Boolean?
  marksAwarded   Int      @default(0)
  createdAt      DateTime @default(now())

  registration   PortalRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question       PortalQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, questionId])
  @@index([registrationId])
  @@map("portal_answers")
}

enum PortalRegistrationStatus {
  registered
  in_progress
  submitted
  expired
}


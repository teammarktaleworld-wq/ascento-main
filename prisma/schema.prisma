generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  student
  user
  teacher
}

enum UserStatus {
  Active
  Inactive
  Suspended
  Deleted
}

enum NoteType {
  DEMO
  REAL
}

enum AttendanceStatus {
  present
  absent
  late
  holiday
}

enum FeeStatus {
  Pending
  Paid
  Partial
  Overdue
  Waived
}

enum AnnouncementPriority {
  info
  normal
  urgent
}

enum WebinarStatus {
  active
  inactive
}

enum WebinarPlatform {
  zoom
  google_meet
  microsoft_teams
  other
}

enum NotificationType {
  webinar
  announcement
  exam
  attendance
  general
}

enum AnnouncementAudience {
  all
  program
  level
  teachers
  students
}

enum CouponScope {
  global // applies to any note or test paper
  note // applies to one specific note
  test_paper // applies to one specific test paper
}

// ─── Models ──────────────────────────────────────────────────────────────────

model SummerCampEnrollment {
  id         String   @id @default(uuid())
  childName  String
  parentName String?
  phone      String
  email      String?
  ageGroup   String
  program    String
  message    String?
  status     String   @default("New")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("summer_camp_enrollments")
}

model ContactEnquiry {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  email       String?
  childAge    String?
  reason      String?
  message     String?
  program     String?
  submittedAt DateTime @default(now())

  @@map("contact_enquiries")
}

model User {
  id        String     @id
  email     String     @unique
  name      String?
  phone     String?
  city      String?
  avatarUrl String?
  role      UserRole   @default(user)
  status    UserStatus @default(Active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  student       Student?
  teacher       Teacher?
  enquiries     Enquiry[]      @relation("EnquiryCreatedBy")
  notifications Notification[]
  purchases     Purchase[]
  examAttempts  ExamAttempt[]

  @@map("users")
}

// ─── Note Category ────────────────────────────────────────────────────────────

model NoteCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes Note[]

  @@map("note_categories")
}

// ─── Note ─────────────────────────────────────────────────────────────────────
// Each note has a Demo PDF and/or a Real (full) PDF.
// At least one must be present. Price + optional discount.

model Note {
  id              String   @id @default(cuid())
  serialId        Int      @unique
  title           String
  label           String   @default("")
  categoryId      String?
  price           Float    @default(0) // 0 = free
  discountPercent Float? // e.g. 20 = 20% off
  // Demo version
  demoUrl         String?
  demoPath        String? // Supabase storage path
  // Real (full) version
  realUrl         String?
  realPath        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category  NoteCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coupons   Coupon[]      @relation("NoteCoupons")
  purchases Purchase[]

  @@index([categoryId])
  @@index([price])
  @@map("notes")
}

// ─── Test Paper Category ──────────────────────────────────────────────────────

model TestPaperCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  papers TestPaper[]

  @@map("test_paper_categories")
}

// ─── Test Paper ───────────────────────────────────────────────────────────────

model TestPaper {
  id         String  @id @default(cuid())
  serialId   Int     @unique
  title      String
  label      String  @default("")
  categoryId String?

  price           Float  @default(0)
  discountPercent Float?

  // Demo PDF
  demoUrl  String?
  demoPath String?

  // Purchased PDF
  realUrl  String?
  realPath String?

  // Legacy fields
  fileUrl  String?
  filePath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  TestPaperCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coupons   Coupon[]           @relation("TestPaperCoupons")
  purchases Purchase[]

  @@index([categoryId])
  @@index([price])
  @@map("test_papers")
}

// ─── Coupon ───────────────────────────────────────────────────────────────────

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  discountPercent Float // 1–100
  scope           CouponScope @default(global)
  // If scope = note, this links to the specific note
  noteId          String?
  // If scope = test_paper, this links to the specific paper
  testPaperId     String?
  maxUses         Int? // null = unlimited
  usedCount       Int         @default(0)
  expiresAt       DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  note      Note?      @relation("NoteCoupons", fields: [noteId], references: [id], onDelete: SetNull)
  testPaper TestPaper? @relation("TestPaperCoupons", fields: [testPaperId], references: [id], onDelete: SetNull)
  purchases Purchase[]

  @@index([code])
  @@index([scope])
  @@index([isActive])
  @@map("coupons")
}

// ─── Purchase ─────────────────────────────────────────────────────────────────

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  // Exactly one of these is set
  noteId          String?
  testPaperId     String?
  couponId        String? // coupon used, if any
  originalPrice   Float // price before discount
  finalPrice      Float // price actually paid (0 if free/fully discounted)
  discountApplied Float    @default(0) // amount saved
  purchasedAt     DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note?      @relation(fields: [noteId], references: [id], onDelete: SetNull)
  testPaper TestPaper? @relation(fields: [testPaperId], references: [id], onDelete: SetNull)
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([noteId])
  @@index([testPaperId])
  @@index([purchasedAt])
  @@map("purchases")
}

// ─── Program ─────────────────────────────────────────────────────────────────

model Program {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  hasLevels   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels           ProgramLevel[]
  students         Student[]
  scheduleSlots    ScheduleSlot[]
  timetableUploads TimetableUpload[]
  announcements    Announcement[]
  exams            Exam[]
  webinars         Webinar[]

  @@map("programs")
}

// ─── ProgramLevel ─────────────────────────────────────────────────────────────

model ProgramLevel {
  id        String   @id @default(uuid())
  programId String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program          Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  students         Student[]
  scheduleSlots    ScheduleSlot[]
  timetableUploads TimetableUpload[]
  announcements    Announcement[]
  exams            Exam[]
  webinars         Webinar[]

  @@unique([programId, name])
  @@map("program_levels")
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  studentId     String    @unique
  rollNumber    String?
  fullName      String
  photoUrl      String?
  dateOfBirth   DateTime?
  admissionDate DateTime?
  gender        String?
  bloodGroup    String?
  phone         String?
  address       String?
  city          String?
  state         String?
  parentName    String?
  parentPhone   String?
  parentEmail   String?
  status        String    @default("Active")
  section       String?
  academicYear  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  programId      String?
  programLevelId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program?      @relation(fields: [programId], references: [id])
  programLevel ProgramLevel? @relation(fields: [programLevelId], references: [id])
  attendance   Attendance[]
  fees         StudentFee[]

  @@map("students")
}

// ─── StudentFee ───────────────────────────────────────────────────────────────

model StudentFee {
  id           String    @id @default(cuid())
  studentId    String
  feeType      String
  description  String?
  amount       Float
  paidAmount   Float     @default(0)
  dueDate      DateTime?
  paidDate     DateTime?
  status       FeeStatus @default(Pending)
  month        String?
  academicYear String?
  receiptNo    String?
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("student_fees")
}

// ─── Exam ─────────────────────────────────────────────────────────────────────

model Exam {
  id            String    @id @default(cuid())
  examName      String
  description   String?
  examStartDate DateTime?
  examEndDate   DateTime?
  programId     String?
  levelId       String?
  fileUrl       String?
  fileType      String?
  fileName      String?
  storagePath   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  program Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  level   ProgramLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([levelId])
  @@index([examStartDate])
  @@map("exams")
}

// ─── Teacher ──────────────────────────────────────────────────────────────────

model Teacher {
  id              String    @id @default(uuid())
  userId          String    @unique
  name            String
  phone           String?
  experience      String?
  designation     String?
  wifeOrHusbandOf String?
  photoUrl        String?
  dateOfBirth     DateTime?
  status          String    @default("Active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects TeacherSubject[]

  @@map("teachers")
}

// ─── Subject ──────────────────────────────────────────────────────────────────

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  teachers TeacherSubject[]

  @@map("subjects")
}

// ─── Webinar ──────────────────────────────────────────────────────────────────

model Webinar {
  id                    String          @id @default(cuid())
  title                 String
  description           String?
  platform              WebinarPlatform @default(zoom)
  meetingLink           String
  meetingId             String?
  passcode              String?
  hostName              String?
  hostEmail             String?
  scheduledAt           DateTime
  durationMins          Int             @default(60)
  status                WebinarStatus   @default(active)
  programId             String?
  levelId               String?
  emailSent             Boolean         @default(false)
  emailSentAt           DateTime?
  emailSentCount        Int             @default(0)
  notificationSent      Boolean         @default(false)
  notificationSentAt    DateTime?
  notificationSentCount Int             @default(0)
  bannerUrl             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  program       Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  level         ProgramLevel?  @relation(fields: [levelId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([scheduledAt])
  @@index([programId])
  @@index([status])
  @@map("webinars")
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(general)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  webinarId String?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─── TeacherSubject ───────────────────────────────────────────────────────────

model TeacherSubject {
  teacherId  String
  subjectId  String
  assignedAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

// ─── HomeworkFile ─────────────────────────────────────────────────────────────

model HomeworkFile {
  id          String   @id @default(uuid())
  serialId    Int      @unique
  title       String
  label       String?
  fileType    String
  fileUrl     String
  storagePath String
  createdAt   DateTime @default(now())

  @@map("homework_files")
}

// ─── Enquiry ──────────────────────────────────────────────────────────────────

model Enquiry {
  id          String   @id @default(uuid())
  studentName String
  email       String
  phone       String?
  course      String?
  source      String?
  message     String?
  status      String   @default("New")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("EnquiryCreatedBy", fields: [createdById], references: [id])

  @@map("enquiries")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  markedBy  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId])
  @@map("attendance")
}

// ─── Announcement ─────────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(cuid())
  title       String
  message     String
  priority    AnnouncementPriority @default(normal)
  audience    AnnouncementAudience @default(all)
  programId   String?
  levelId     String?
  fileUrl     String?
  fileType    String?
  fileName    String?
  storagePath String?
  expiresAt   DateTime?
  isActive    Boolean              @default(true)
  emailSent   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  program Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  level   ProgramLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  @@index([audience])
  @@index([programId])
  @@index([isActive])
  @@map("announcements")
}

// ─── ScheduleSlot ─────────────────────────────────────────────────────────────

model ScheduleSlot {
  id           String   @id @default(cuid())
  programId    String
  levelId      String?
  dayOfWeek    String
  periodNumber Int
  startTime    String
  endTime      String
  subjectName  String
  teacherName  String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program Program       @relation(fields: [programId], references: [id])
  level   ProgramLevel? @relation(fields: [levelId], references: [id])

  @@unique([programId, levelId, dayOfWeek, periodNumber])
  @@index([programId])
  @@index([levelId])
  @@map("schedule_slots")
}

// ─── TimetableUpload ──────────────────────────────────────────────────────────

model TimetableUpload {
  id           String   @id @default(cuid())
  programId    String?
  levelId      String?
  originalName String
  storagePath  String
  url          String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  program Program?      @relation(fields: [programId], references: [id])
  level   ProgramLevel? @relation(fields: [levelId], references: [id])

  @@index([programId])
  @@map("timetable_uploads")
}

//Models for online exam portal

model ExamCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tests OnlineTest[]

  @@map("exam_categories")
}

model OnlineTest {
  id              String  @id @default(cuid())
  title           String
  description     String?
  durationMinutes Int     @default(20)
  totalMarks      Int     @default(20)
  categoryId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  ExamCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  ExamAttempt[]

  @@index([categoryId])
  @@map("online_tests")
}

model Question {
  id     String @id @default(cuid())
  testId String

  question String

  optionA String
  optionB String
  optionC String
  optionD String

  correctAnswer String

  marks Int @default(1)

  createdAt DateTime @default(now())

  test        OnlineTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  examAnswers ExamAnswer[] @relation("QuestionAnswers")

  @@index([testId])
  @@map("questions")
}

model ExamAttempt {
  id     String @id @default(cuid())
  userId String
  testId String

  score      Int @default(0)
  totalMarks Int @default(0)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  test OnlineTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  answers ExamAnswer[]

  @@index([userId])
  @@index([testId])
  @@map("exam_attempts")
}

model ExamAnswer {
  id String @id @default(cuid())

  attemptId  String
  questionId String

  selectedAnswer String?
  isCorrect      Boolean @default(false)

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("exam_answers")
}

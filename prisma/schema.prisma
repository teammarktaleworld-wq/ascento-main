generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SummerCampEnrollment {
  id         String   @id @default(uuid())
  childName  String
  parentName String?
  phone      String
  email      String?
  ageGroup   String
  program    String
  message    String?
  status     String   @default("New")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("summer_camp_enrollments")
}

model ContactEnquiry {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  email       String?
  childAge    String?
  reason      String?
  message     String?
  program     String?
  submittedAt DateTime @default(now())

  @@map("contact_enquiries")
}

model User {
  id            String         @id
  email         String         @unique
  name          String?
  phone         String?
  avatarUrl     String?
  role          UserRole       @default(user)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  city          String?
  status        UserStatus     @default(Active)
  forceLogoutAt DateTime?
  enquiries     Enquiry[]      @relation("EnquiryCreatedBy")
  notifications Notification[]
  purchases     Purchase[]
  student       Student?
  teacher       Teacher?
    emailLogs  AnnouncementEmailLog[]
     portalRegistrations  PortalRegistration[]  @relation("PortalRegistrations")


  @@map("users")
}

model NoteCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note[]

  @@map("note_categories")
}

model Note {
  id              String        @id @default(cuid())
  serialId        Int           @unique
  title           String
  label           String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  categoryId      String?
  demoPath        String?
  demoUrl         String?
  discountPercent Float?
  price           Float         @default(0)
  realPath        String?
  realUrl         String?
  coupons         Coupon[]      @relation("NoteCoupons")
  category        NoteCategory? @relation(fields: [categoryId], references: [id])
  purchases       Purchase[]

  @@index([categoryId])
  @@index([price])
  @@map("notes")
}

model TestPaperCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  papers      TestPaper[]

  @@map("test_paper_categories")
}

model TestPaper {
  id              String             @id @default(cuid())
  serialId        Int                @unique
  title           String
  label           String             @default("")
  categoryId      String?
  price           Float              @default(0)
  discountPercent Float?
  fileUrl         String?
  filePath        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  demoPath        String?
  demoUrl         String?
  realPath        String?
  realUrl         String?
  coupons         Coupon[]           @relation("TestPaperCoupons")
  purchases       Purchase[]
  category        TestPaperCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([price])
  @@map("test_papers")
}

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  discountPercent Float
  scope           CouponScope @default(global)
  noteId          String?
  testPaperId     String?
  maxUses         Int?
  usedCount       Int         @default(0)
  expiresAt       DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  note            Note?       @relation("NoteCoupons", fields: [noteId], references: [id])
  testPaper       TestPaper?  @relation("TestPaperCoupons", fields: [testPaperId], references: [id])
  purchases       Purchase[]

  @@index([code])
  @@index([scope])
  @@index([isActive])
  @@map("coupons")
}

model Purchase {
  id              String     @id @default(cuid())
  userId          String
  noteId          String?
  testPaperId     String?
  couponId        String?
  originalPrice   Float
  finalPrice      Float
  discountApplied Float      @default(0)
  purchasedAt     DateTime   @default(now())
  coupon          Coupon?    @relation(fields: [couponId], references: [id])
  note            Note?      @relation(fields: [noteId], references: [id])
  testPaper       TestPaper? @relation(fields: [testPaperId], references: [id])
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([noteId])
  @@index([testPaperId])
  @@index([purchasedAt])
  @@map("purchases")
}

model Program {
  id               String            @id @default(uuid())
  name             String            @unique
  description      String?
  hasLevels        Boolean           @default(false)
  sortOrder        Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  announcements    Announcement[]
  exams            Exam[]
  levels           ProgramLevel[]
  scheduleSlots    ScheduleSlot[]
  students         Student[]
  timetableUploads TimetableUpload[]
  webinars         Webinar[]

  @@map("programs")
}

model ProgramLevel {
  id               String            @id @default(uuid())
  programId        String
  name             String
  sortOrder        Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  announcements    Announcement[]
  exams            Exam[]
  program          Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  scheduleSlots    ScheduleSlot[]
  students         Student[]
  timetableUploads TimetableUpload[]
  webinars         Webinar[]

  @@unique([programId, name])
  @@map("program_levels")
}

model Student {
  id             String        @id @default(uuid())
  userId         String        @unique
  studentId      String        @unique
  rollNumber     String?
  fullName       String
  dateOfBirth    DateTime?
  gender         String?
  bloodGroup     String?
  phone          String?
  address        String?
  city           String?
  state          String?
  parentName     String?
  parentPhone    String?
  parentEmail    String?
  status         String        @default("Active")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  academicYear   String?
  section        String?
  programId      String?
  programLevelId String?
  photoUrl       String?
  admissionDate  DateTime?
  attendance     Attendance[]
  fees           StudentFee[]
  program        Program?      @relation(fields: [programId], references: [id])
  programLevel   ProgramLevel? @relation(fields: [programLevelId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model StudentFee {
  id           String    @id @default(cuid())
  studentId    String
  feeType      String
  description  String?
  amount       Float
  paidAmount   Float     @default(0)
  dueDate      DateTime?
  paidDate     DateTime?
  status       FeeStatus @default(Pending)
  month        String?
  academicYear String?
  receiptNo    String?
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("student_fees")
}

model Exam {
  id             String         @id @default(cuid())
  examName       String
  description    String?
  examStartDate  DateTime?
  examEndDate    DateTime?
  programId      String?
  levelId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  fileName       String?
  fileType       String?
  fileUrl        String?
  storagePath    String?
  emailSentAt    DateTime?
  emailSentCount Int            @default(0)
  notifSentAt    DateTime?
  notifSentCount Int            @default(0)
  level          ProgramLevel?  @relation(fields: [levelId], references: [id])
  program        Program?       @relation(fields: [programId], references: [id])
  notifications  Notification[]

  @@index([programId])
  @@index([levelId])
  @@index([examStartDate])
  @@map("exams")
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  student
  teacher
  user
}

enum NoteType {
  DEMO
  REAL
}

enum AttendanceStatus {
  present
  absent
  late
  holiday
}




enum FeeStatus {
  Pending
  Paid
  Partial
  Overdue
  Waived
}

enum AnnouncementPriority {
  info
  normal
  urgent
}

enum WebinarStatus {
  active
  inactive
}

enum WebinarPlatform {
  zoom
  google_meet
  microsoft_teams
  other
}

enum NotificationType {
  webinar
  announcement
  exam
  attendance
  general
}

enum AnnouncementAudience {
  all
  students
  teachers
  program
  level
}

// ─── Models ──────────────────────────────────────────────────────────────────

model SummerCampEnrollment {
  id         String   @id @default(uuid())
  childName  String
  parentName String?
  phone      String
  email      String?
  ageGroup   String
  program    String
  message    String?
  status     String   @default("New")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("summer_camp_enrollments")
}

model Note {
  id          String    @id @default(cuid())
  serialId    Int
  title       String
  label       String    @default("")
  type        NoteType
  pdfUrl      String
  storagePath String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  @@map("notes")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note[]
}

model ContactEnquiry {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  email       String?
  childAge    String?
  reason      String?
  message     String?
  program     String?
  submittedAt DateTime @default(now())

  @@map("ContactEnquiry")
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  phone     String?
  city      String?
  avatarUrl String?
  role      UserRole @default(user)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       Student?
  teacher       Teacher?
  enquiries     Enquiry[]      @relation("EnquiryCreatedBy")
  notifications Notification[]

  @@map("users")
}

// ─── Program ─────────────────────────────────────────────────────────────────

model Program {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  hasLevels   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels           ProgramLevel[]
  students         Student[]
  scheduleSlots    ScheduleSlot[]
  timetableUploads TimetableUpload[]
  announcements    Announcement[]
  exams            Exam[]
  webinars         Webinar[]

  @@map("programs")
}

// ─── ProgramLevel ─────────────────────────────────────────────────────────────

model ProgramLevel {
  id        String   @id @default(uuid())
  programId String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program          Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  students         Student[]
  scheduleSlots    ScheduleSlot[]
  timetableUploads TimetableUpload[]
  announcements    Announcement[]
  exams            Exam[]
  webinars         Webinar[]

  @@unique([programId, name])
  @@map("program_levels")
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id             String    @id @default(uuid())
  userId         String    @unique
  studentId      String    @unique
  rollNumber     String?
  fullName       String
  photoUrl       String?
  dateOfBirth    DateTime?
  admissionDate  DateTime?
  gender         String?
  bloodGroup     String?
  phone          String?
  address        String?
  city           String?
  state          String?
  parentName     String?
  parentPhone    String?
  parentEmail    String?
  status         String    @default("Active")
  section        String?
  academicYear   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  programId      String?
  programLevelId String?
  attendance     Attendance[]
  fees StudentFee[]

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program?      @relation(fields: [programId], references: [id])
  programLevel ProgramLevel? @relation(fields: [programLevelId], references: [id])

  @@map("students")
}




// ─── StudentFee ───────────────────────────────────────────────────────────────



model StudentFee {
  id          String    @id @default(cuid())
  studentId   String
  feeType     String                      // e.g. "Tuition", "Admission", "Activity"
  description String?
  amount      Float
  paidAmount  Float     @default(0)
  dueDate     DateTime?
  paidDate    DateTime?
  status      FeeStatus @default(Pending)
  month       String?                     // e.g. "June 2025"
  academicYear String?
  receiptNo   String?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("student_fees")
}









// ─── Exam ─────────────────────────────────────────────────────────────────────

model Exam {
  id            String        @id @default(cuid())
  examName      String
  description   String?
  examStartDate DateTime?
  examEndDate   DateTime?
  programId     String?
  program       Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  levelId       String?
  level         ProgramLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  fileUrl       String?
  fileType      String?
  fileName      String?
  storagePath   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([programId])
  @@index([levelId])
  @@index([examStartDate])
  @@map("exams")
}

// ─── Teacher ──────────────────────────────────────────────────────────────────

model Teacher {
  id              String    @id @default(uuid())
  userId          String    @unique
  name            String
  phone           String?
  experience      String?
  designation     String?
  wifeOrHusbandOf String?
  photoUrl        String?
  dateOfBirth     DateTime?
  status          String    @default("Active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects TeacherSubject[]

  @@map("teachers")
}

// ─── Subject ──────────────────────────────────────────────────────────────────

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  teachers TeacherSubject[]

  @@map("subjects")
}

// ─── Webinar ──────────────────────────────────────────────────────────────────

model Webinar {
  id           String          @id @default(cuid())
  title        String
  description  String?
  platform     WebinarPlatform @default(zoom)
  meetingLink  String
  meetingId    String?
  passcode     String?
  hostName     String?
  hostEmail    String?

  scheduledAt  DateTime
  durationMins Int             @default(60)

  // active = upcoming/ongoing, inactive = past or manually disabled
  status       WebinarStatus   @default(active)

  // null = visible to everyone
  programId    String?
  levelId      String?

  // Email tracking — increments on every send, never a one-time gate
  emailSent         Boolean   @default(false)
  emailSentAt       DateTime?
  emailSentCount    Int       @default(0)

  // In-app notification tracking — increments on every send
  notificationSent      Boolean   @default(false)
  notificationSentAt    DateTime?
  notificationSentCount Int       @default(0)

  bannerUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  program       Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  level         ProgramLevel? @relation(fields: [levelId],   references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([scheduledAt])
  @@index([programId])
  @@index([status])
  @@map("webinars")
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(general)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  webinarId String?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─── TeacherSubject ───────────────────────────────────────────────────────────

model TeacherSubject {
  teacherId  String
  subjectId  String
  assignedAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

// ─── HomeworkFile ─────────────────────────────────────────────────────────────

model HomeworkFile {
  id          String   @id @default(uuid())
  serialId    Int      @unique
  title       String
  label       String?
  fileType    String
  fileUrl     String
  storagePath String
  createdAt   DateTime @default(now())

  @@map("homework_files")
}

// ─── Enquiry ──────────────────────────────────────────────────────────────────

model Enquiry {
  id          String   @id @default(uuid())
  studentName String
  email       String
  phone       String?
  course      String?
  source      String?
  message     String?
  status      String   @default("New")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("EnquiryCreatedBy", fields: [createdById], references: [id])

  @@map("enquiries")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  markedBy  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId])
  @@map("attendance")
}

// ─── Announcement ─────────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(cuid())
  title       String
  message     String
  priority    AnnouncementPriority @default(normal)
  audience    AnnouncementAudience @default(all)
  programId   String?
  levelId     String?
  fileUrl     String?
  fileType    String?
  fileName    String?
  storagePath String?
  expiresAt   DateTime?
  isActive    Boolean              @default(true)
  emailSent   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  program Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  level   ProgramLevel? @relation(fields: [levelId],   references: [id], onDelete: SetNull)

  @@index([audience])
  @@index([programId])
  @@index([isActive])
  @@map("announcements")
}

// ─── ScheduleSlot ─────────────────────────────────────────────────────────────

model ScheduleSlot {
  id           String   @id @default(cuid())
  programId    String
  levelId      String?
  dayOfWeek    String
  periodNumber Int
  startTime    String
  endTime      String
  subjectName  String
  teacherName  String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program Program       @relation(fields: [programId], references: [id])
  level   ProgramLevel? @relation(fields: [levelId],   references: [id])

  @@unique([programId, levelId, dayOfWeek, periodNumber])
  @@index([programId])
  @@index([levelId])
  @@map("schedule_slots")
}

// ─── TimetableUpload ──────────────────────────────────────────────────────────

model TimetableUpload {
  id           String   @id @default(cuid())
  programId    String?
  levelId      String?
  originalName String
  storagePath  String
  url          String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  program Program?      @relation(fields: [programId], references: [id])
  level   ProgramLevel? @relation(fields: [levelId],   references: [id])

  @@index([programId])
  @@map("timetable_uploads")
}
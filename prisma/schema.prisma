generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  student
  teacher
  user
}

enum NoteType {
  DEMO
  REAL
}

enum AnnouncementPriority {
  info
  normal
  urgent
}

enum AnnouncementAudience {
  all
  students
  teachers
  program
  level
}

// ─── Models ──────────────────────────────────────────────────────────────────

model SummerCampEnrollment {
  id         String   @id @default(uuid())
  childName  String
  parentName String?
  phone      String
  email      String?
  ageGroup   String
  program    String
  message    String?
  status     String   @default("New")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("summer_camp_enrollments")
}

model Note {
  id          String    @id @default(cuid())
  serialId    Int
  title       String
  label       String    @default("")
  type        NoteType
  pdfUrl      String
  storagePath String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  @@map("notes")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note[]
}

model ContactEnquiry {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  email       String?
  childAge    String?
  reason      String?
  message     String?
  program     String?
  submittedAt DateTime @default(now())

  @@map("ContactEnquiry")
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  phone     String?
  city      String?
  avatarUrl String?
  role      UserRole @default(user)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student?
  teacher   Teacher?
  enquiries Enquiry[] @relation("EnquiryCreatedBy")

  @@map("users")
}

// ─── Program ─────────────────────────────────────────────────────────────────

model Program {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  hasLevels   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels           ProgramLevel[]
  students         Student[]
  scheduleSlots    ScheduleSlot[]
  timetableUploads TimetableUpload[]
  announcements    Announcement[]

  @@map("programs")
}

// ─── ProgramLevel ─────────────────────────────────────────────────────────────

model ProgramLevel {
  id        String   @id @default(uuid())
  programId String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program          Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  students         Student[]
  scheduleSlots    ScheduleSlot[]
  timetableUploads TimetableUpload[]
  announcements    Announcement[]

  @@unique([programId, name])
  @@map("program_levels")
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id             String    @id @default(uuid())
  userId         String    @unique
  studentId      String    @unique
  rollNumber     String?
  fullName       String
  dateOfBirth    DateTime?
  gender         String?
  bloodGroup     String?
  phone          String?
  address        String?
  city           String?
  state          String?
  parentName     String?
  parentPhone    String?
  parentEmail    String?
  status         String    @default("Active")
  section        String?
  academicYear   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  programId      String?
  programLevelId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program?      @relation(fields: [programId], references: [id])
  programLevel ProgramLevel? @relation(fields: [programLevelId], references: [id])

  @@map("students")
}

// ─── Teacher ──────────────────────────────────────────────────────────────────

model Teacher {
  id         String   @id @default(uuid())
  userId     String   @unique
  name       String
  phone      String?
  experience String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects TeacherSubject[]

  @@map("teachers")
}

// ─── Subject ──────────────────────────────────────────────────────────────────
// Shared catalogue of subject names (e.g. "Mathematics", "Abacus Level 1").
// Subjects are upserted by name so there are no duplicates.

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  teachers TeacherSubject[]

  @@map("subjects")
}

// ─── TeacherSubject ───────────────────────────────────────────────────────────
// Many-to-many join between Teacher and Subject.

model TeacherSubject {
  teacherId  String
  subjectId  String
  assignedAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

// ─── HomeworkFile ─────────────────────────────────────────────────────────────

model HomeworkFile {
  id          String   @id @default(uuid())
  serialId    Int      @unique
  title       String
  label       String?
  fileType    String
  fileUrl     String
  storagePath String
  createdAt   DateTime @default(now())

  @@map("homework_files")
}

// ─── Enquiry ──────────────────────────────────────────────────────────────────

model Enquiry {
  id          String   @id @default(uuid())
  studentName String
  email       String
  phone       String?
  course      String?
  source      String?
  message     String?
  status      String   @default("New")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("EnquiryCreatedBy", fields: [createdById], references: [id])

  @@map("enquiries")
}

// ─── Announcement ─────────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(cuid())
  title       String
  message     String
  priority    AnnouncementPriority @default(normal)
  audience    AnnouncementAudience @default(all)
  programId   String?
  levelId     String?
  fileUrl     String?
  fileType    String?              // "pdf" | "image"
  fileName    String?
  storagePath String?
  expiresAt   DateTime?
  isActive    Boolean              @default(true)
  emailSent   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  program Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  level   ProgramLevel? @relation(fields: [levelId],   references: [id], onDelete: SetNull)

  @@index([audience])
  @@index([programId])
  @@index([isActive])
  @@map("announcements")
}

// ─── ScheduleSlot ─────────────────────────────────────────────────────────────
// One row = one class period (e.g. Monday P2 — Mathematics — Mrs. Sharma)

model ScheduleSlot {
  id           String   @id @default(cuid())
  programId    String
  levelId      String?
  dayOfWeek    String   // "Monday" | "Tuesday" | … | "Saturday"
  periodNumber Int      // 1–12
  startTime    String   // "09:00"
  endTime      String   // "10:00"
  subjectName  String
  teacherName  String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program Program       @relation(fields: [programId], references: [id])
  level   ProgramLevel? @relation(fields: [levelId], references: [id])

  // No two classes can share the same period on the same day for a program+level
  @@unique([programId, levelId, dayOfWeek, periodNumber])
  @@index([programId])
  @@index([levelId])
  @@map("schedule_slots")
}

// ─── TimetableUpload ──────────────────────────────────────────────────────────
// Stores uploaded timetable images / PDFs (uploaded directly to Supabase Storage)

model TimetableUpload {
  id           String   @id @default(cuid())
  programId    String?
  levelId      String?
  originalName String
  storagePath  String
  url          String
  mimeType     String
  size         Int      // bytes
  createdAt    DateTime @default(now())

  program Program?      @relation(fields: [programId], references: [id])
  level   ProgramLevel? @relation(fields: [levelId], references: [id])

  @@index([programId])
  @@map("timetable_uploads")
}
